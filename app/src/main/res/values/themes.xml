<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Stratos" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dawn</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/ink</item>
    </style>

    <style name="Theme.Stratos.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dawn</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Stratos</item>
    </style>
</resources>
